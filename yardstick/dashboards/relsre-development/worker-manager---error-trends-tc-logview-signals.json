{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Tracks worker-manager error signals equivalent to tc-logview `worker-error` and `worker-removed` events. Prometheus-native panels for trend analysis; pair with tc-logview for per-error-reason breakdown.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "Headline counters (24h)",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "tc-logview equivalent: `worker-error` events with `OS Provisioning did not finish` / `ARM Deployment Error` titles. One tile per pool matching the regex.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 50
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (workerPoolId) (increase(fxci_worker_manager_worker_registration_failures_total{workerPoolId=~\"$workerPoolId\", providerId=~\"$providerId\"}[24h]))",
          "instant": true,
          "legendFormat": "{{workerPoolId}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Registration failures (24h) per pool",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "tc-logview equivalent: `worker-removed` with reason `vm not found in state running`. Note: only populated for GCP-provisioned pools; Azure pools show no data here \u2014 use registration failures instead.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 500
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (workerPoolId) (increase(fxci_worker_manager_worker_pool_scan_errors{workerPoolId=~\"$workerPoolId\", providerId=~\"$providerId\"}[24h]))",
          "instant": true,
          "legendFormat": "{{workerPoolId}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Worker-pool scan errors (24h) per pool",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Azure ARM rate-limit hits by operation. Provider-scope metric (no workerPoolId label), shown across all pools regardless of regex.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (operationType) (increase(fxci_worker_manager_azure_throttle_total[24h]))",
          "instant": true,
          "legendFormat": "{{operationType}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Azure throttles (24h) by operation type",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Spot-eviction storm signal per pool. Healthy >30 min; <10 min = VMs evicted before claiming work.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "orange",
                "value": 1800
              },
              {
                "color": "green",
                "value": 3600
              }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, workerPoolId)(rate(fxci_worker_manager_worker_lifetime_seconds_bucket{workerPoolId=~\"$workerPoolId\"}[1h])))",
          "instant": true,
          "legendFormat": "{{workerPoolId}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Worker lifetime p50 per pool (storm canary)",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 6,
      "panels": [],
      "title": "Error rates over time",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Counts ARM Deployment Errors, OS Provisioning timeouts, VM did-not-start events. Trend up = supply pressure building.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "id": 7,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (workerPoolId) (rate(fxci_worker_manager_worker_registration_failures_total{workerPoolId=~\"$workerPoolId\", providerId=~\"$providerId\"}[$__rate_interval]))",
          "legendFormat": "{{workerPoolId}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Registration failures rate by pool",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Worker-scanner errors. Maps to tc-logview `vm not found in state running` removals \u2014 the scanner is finding live TC worker records with no matching Azure VM (ghost workers / silent evictions).",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "id": 8,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (workerPoolId) (rate(fxci_worker_manager_worker_pool_scan_errors{workerPoolId=~\"$workerPoolId\", providerId=~\"$providerId\"}[$__rate_interval]))",
          "legendFormat": "{{workerPoolId}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Worker-pool scan errors rate by pool",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Azure ARM rate-limit hits per operation type. High values mean worker-manager is racing the Azure control plane \u2014 often a leading indicator of the eviction-and-redeploy storms.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 9,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (operationType) (rate(fxci_worker_manager_azure_throttle_total[$__rate_interval]))",
          "legendFormat": "{{operationType}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Azure throttles by operation type",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Headroom on the Azure subscription's ARM rate limits. Dropping toward zero indicates the storm is also straining the Azure control plane.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [
            "min",
            "mean"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "min by (limitType) (fxci_worker_manager_azure_ratelimit_remaining)",
          "legendFormat": "{{limitType}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Azure rate-limit remaining (subscription)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 11,
      "panels": [],
      "title": "Storm signals \u2014 lifetime, capacity, queue impact",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Direct Spot-storm canary. If p50 dives below ~30 min while p95 stays flat, evictions are killing short-lived VMs before they claim tasks. Both falling = systemic storm.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 25
      },
      "id": 12,
      "options": {
        "legend": {
          "calcs": [
            "last",
            "min"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, workerPoolId)(rate(fxci_worker_manager_worker_lifetime_seconds_bucket{workerPoolId=~\"$workerPoolId\"}[$__rate_interval])))",
          "legendFormat": "p50 {{workerPoolId}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, workerPoolId)(rate(fxci_worker_manager_worker_lifetime_seconds_bucket{workerPoolId=~\"$workerPoolId\"}[$__rate_interval])))",
          "legendFormat": "p95 {{workerPoolId}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Worker lifetime p50 / p95 per pool",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "When `stopping` is a large fraction of `existing`, worker-manager has VMs in 'stopping' state that Azure has already deleted (ghosts). Maps to the queue-diagnosis `ghost_count` heuristic.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 25
      },
      "id": 13,
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (workerPoolId) (fxci_worker_manager_existing_capacity{workerPoolId=~\"$workerPoolId\"})",
          "legendFormat": "existing {{workerPoolId}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (workerPoolId) (fxci_worker_manager_stopping_capacity{workerPoolId=~\"$workerPoolId\"})",
          "legendFormat": "stopping {{workerPoolId}}",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Stopping vs Existing capacity (ghost backlog)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Queue pressure: when pending climbs while running/idle stay flat, the supply side is failing.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 34
      },
      "id": 14,
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (workerPoolId) (fxci_worker_manager_pending_tasks{workerPoolId=~\"$workerPoolId\"})",
          "legendFormat": "{{workerPoolId}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Pending tasks per pool",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Worker-scanner's queue of workers needing deprovision. Climbing values mean ghost-reaping is falling behind eviction arrival.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 34
      },
      "id": 15,
      "options": {
        "legend": {
          "calcs": [
            "last",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (workerPoolId) (fxci_worker_manager_workers_to_terminate{workerPoolId=~\"$workerPoolId\"})",
          "legendFormat": "{{workerPoolId}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Workers to terminate (scanner backlog)",
      "type": "timeseries"
    }
  ],
  "refresh": "",
  "schemaVersion": 42,
  "tags": [
    "relsre",
    "taskcluster",
    "worker-manager",
    "errors",
    "jmoss"
  ],
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "gcp-v2-prod",
          "value": "adpvtjmrxoc1sb"
        },
        "hide": 0,
        "label": "Prometheus",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "gecko-t/win.*-gpu",
          "value": "gecko-t/win.*-gpu"
        },
        "description": "Regex matched against workerPoolId. Default is Windows GPU pools. Set to .* for all pools.",
        "label": "Worker Pool (regex)",
        "name": "workerPoolId",
        "query": "gecko-t/win.*-gpu",
        "type": "textbox"
      },
      {
        "allValue": ".*",
        "current": {
          "selected": false,
          "text": "All",
          "value": "$__all"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "includeAll": true,
        "label": "Provider",
        "multi": true,
        "name": "providerId",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(fxci_worker_manager_worker_registration_failures_total{workerPoolId=~\"$workerPoolId\"}, providerId)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
